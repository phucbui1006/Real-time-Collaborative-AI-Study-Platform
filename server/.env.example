# Cổng chạy Express / Socket.io server (Render sẽ tự gán qua process.env.PORT)
PORT=3001

# URL của client Frontend (Cho phép CORS & Redirect đặt lại mật khẩu)
# Ví dụ: https://permind.io.vn hoặc http://localhost:5173
CLIENT_URL=https://permind.io.vn
ALLOWED_ORIGINS=https://permind.io.vn,https://www.permind.io.vn,http://localhost:5173

# Cấu hình Supabase Database & Auth (Dùng ở Server để tra email từ username, xác thực JWT, quản lý RLS)
# LƯU Ý BẢO MẬT: SUPABASE_SERVICE_ROLE_KEY chỉ được đặt ở biến môi trường Server / Vercel Serverless, KHÔNG bao giờ đưa xuống client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Gemini API Key cho trợ lý học tập RAG
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình LiveKit Cloud SFU (Hỗ trợ phòng học 50 người, lấy tại https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Số lượng thành viên tối đa trong một phòng học
MAX_MEMBERS=50
