# URL của dự án Supabase (Lấy tại Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Khóa công khai Anon Key của Supabase (TUYỆT ĐỐI KHÔNG đặt SUPABASE_SERVICE_ROLE_KEY ở đây)
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# URL của Express / Socket.io Backend Server (Ví dụ: http://localhost:3001 hoặc URL Render)
VITE_API_URL=http://localhost:3001
